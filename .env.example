# Server Configuration
NODE_ENV=development
PORT=4000
CORS_ALLOWED_ORIGINS=http://localhost:5000

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=flyrank_widgets
POSTGRES_PORT=5433
DATABASE_URL=postgresql://postgres:postgres_dev_password@localhost:5433/flyrank_widgets

# Authentication Secret Placeholder (Phase 1+)
JWT_SECRET=change-this-to-a-secure-secret-in-production

# Widget Delivery Configuration
WIDGET_BASE_URL=http://localhost:4000
